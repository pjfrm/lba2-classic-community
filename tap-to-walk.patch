+/* Host test for tap-to-walk's maths (SOURCES/TAPMOVE_MATH.CPP): the inversion of the live camera
+ * that turns a touch into a spot on the floor, and the steering that turns a heading into key
+ * presses.
+ *
+ * The inversion is checked on the engine's own projection (the 3D library), not on a model of it:
+ * the whole reason it works through LongWorldRotatePoint/LongProjectPoint is that it cannot drift
+ * from what is drawn, so the test must not be a second opinion on what is drawn either. What is
+ * asked of it is the thing a player sees: the point it hands back, projected again, lands under the
+ * finger.
+ */
+#include "TAPMOVE.H"
+#include "test_harness.h"
+
+#include <3D/CAMERA.H>
+#include <3D/DATAMAT.H>
+#include <3D/LPROJ.H>
+#include <3D/LROT3D.H>
+#include <3D/PROJ.H>
+
+#include <math.h>
+#include <stdlib.h>
+
+/* What the 3D library reaches for outside itself, on paths this test does not drive. */
+extern "C" {
+volatile U32 TimerRefHR = 0;
+S32 ScreenXMin = 0, ScreenXMax = 639, ScreenYMin = 0, ScreenYMax = 479;
+}
+
+#define SCREEN_W 640
+#define SCREEN_H 480
+
+static S32 project(S32 x, S32 y, S32 z, S32 *sx, S32 *sy) {
+    LongWorldRotatePoint(x, y, z);
+    if (!LongProjectPoint(X0, Y0, Z0))
+        return 0;
+    *sx = Xp;
+    *sy = Yp;
+    return 1;
+}
+
+static unsigned g_seed = 1234567u;
+static int rnd(int n) {
+    g_seed = g_seed * 1664525u + 1013904223u;
+    return (int)((g_seed >> 8) % (unsigned)n);
+}
+
+/* Project a scatter of floor points, ask for each back from its pixel, and count what goes wrong:
+ * answers that do not land back within two pixels of the finger (the failure that matters), points
+ * it declined to answer for, and the worst the answer was out in the world. */
+static void sweep(S32 hx, S32 hy, S32 hz, S32 range, S32 *tried, S32 *pixelFail, S32 *refused, double *worstWorld) {
+    int i;
+    *tried = *pixelFail = *refused = 0;
+    *worstWorld = 0;
+    for (i = 0; i < 1500; i++) {
+        S32 x = hx + rnd(2 * range + 1) - range;
+        S32 z = hz + rnd(2 * range + 1) - range;
+        S32 sx, sy, gx, gz, rx, ry;
+        double err;
+
+        if (!project(x, hy, z, &sx, &sy) || sx < 0 || sx >= SCREEN_W || sy < 0 || sy >= SCREEN_H)
+            continue;
+        (*tried)++;
+        if (!TapMove_SolveGround(sx, sy, hy, hx, hz, &gx, &gz)) {
+            (*refused)++;
+            continue;
+        }
+        err = hypot((double)(gx - x), (double)(gz - z));
+        if (err > *worstWorld)
+            *worstWorld = err;
+        if (!project(gx, hy, gz, &rx, &ry) || abs(rx - sx) > 2 || abs(ry - sy) > 2)
+            (*pixelFail)++;
+    }
+}
+
+static void test_isometric_camera_inverts_exactly(void) {
+    const S32 hx = 20000, hy = 2048, hz = 15000;
+    S32 tried, pixelFail, refused;
+    double worst;
+
+    SetIsoProjection(SCREEN_W / 2 - 9, SCREEN_H / 2);
+    SetPosCamera(hx, hy, hz);
+    SetAngleCamera(0, 0, 0);
+    sweep(hx, hy, hz, 6000, &tried, &pixelFail, &refused, &worst);
+    ASSERT_TRUE(tried > 500);
+    ASSERT_EQ_INT(0, pixelFail);
+    ASSERT_EQ_INT(0, refused);
+    /* a pixel is 21 world units wide in x and about 43 deep, so one pixel of rounding is the floor */
+    ASSERT_TRUE(worst <= 64.0);
+
+    /* and with the camera somewhere other than on the hero */
+    SetPosCamera(hx + 3000, hy + 512, hz - 2000);
+    sweep(hx, hy, hz, 4000, &tried, &pixelFail, &refused, &worst);
+    ASSERT_TRUE(tried > 300);
+    ASSERT_EQ_INT(0, pixelFail);
+    ASSERT_EQ_INT(0, refused);
+    ASSERT_TRUE(worst <= 64.0);
+}
+
+static void test_perspective_camera_inverts_across_the_auto_cameras_range(void) {
+    const S32 hx = 20000, hy = 2048, hz = 15000;
+    const S32 fovs[2] = {600, 1000};
+    const S32 alphas[3] = {150, 300, 600}; /* elevation: the Auto camera's range is about 150..600 */
+    const S32 betas[4] = {0, 700, 2048, 3300};
+    const S32 dists[3] = {7000, 12000, 20000};
+    int a, b, c, d;
+    S32 totalTried = 0, totalFail = 0, totalRefused = 0;
+    double worstAny = 0;
+
+    for (a = 0; a < 2; a++)
+        for (b = 0; b < 3; b++)
+            for (c = 0; c < 4; c++)
+                for (d = 0; d < 3; d++) {
+                    S32 tried, pixelFail, refused;
+                    double worst;
+                    SetProjection(SCREEN_W / 2, SCREEN_H / 2, 128, fovs[a], fovs[a]);
+                    SetFollowCamera(hx, hy, hz, alphas[b], betas[c], 0, dists[d]);
+                    sweep(hx, hy, hz, 5000, &tried, &pixelFail, &refused, &worst);
+                    totalTried += tried;
+                    totalFail += pixelFail;
+                    totalRefused += refused;
+                    if (worst > worstAny)
+                        worstAny = worst;
+                }
+
+    ASSERT_TRUE(totalTried > 50000);
+    ASSERT_EQ_INT(0, totalFail);                  /* never an answer that is not under the finger */
+    ASSERT_TRUE(totalRefused * 100 < totalTried); /* declines are rare: under 1% */
+    /* The shallowest views at the longest range put hundreds of units under one pixel, so the world
+     * error is bounded by a brick, not by a few pixels' worth. */
+    ASSERT_TRUE(worstAny < 600.0);
+}
+
+static void test_a_tap_above_the_horizon_is_refused(void) {
+    const S32 hx = 20000, hy = 2048, hz = 15000;
+    S32 gx, gz;
+
+    SetProjection(SCREEN_W / 2, SCREEN_H / 2, 128, 1000, 1000);
+    SetFollowCamera(hx, hy, hz, 150, 0, 0, 12000);
+    ASSERT_EQ_INT(0, TapMove_SolveGround(SCREEN_W / 2, 2, hy, hx, hz, &gx, &gz));
+}
+
+static void test_project_and_solve_leave_the_scratch_globals_alone(void) {
+    const S32 hx = 20000, hy = 2048, hz = 15000;
+    S32 sx, sy, gx, gz;
+
+    SetIsoProjection(SCREEN_W / 2 - 9, SCREEN_H / 2);
+    SetPosCamera(hx, hy, hz);
+    SetAngleCamera(0, 0, 0);
+
+    X0 = 111;
+    Y0 = 222;
+    Z0 = 333;
+    Xp = 444;
+    Yp = 555;
+    ASSERT_EQ_INT(1, TapMove_Project(hx + 1000, hy, hz + 500, &sx, &sy));
+    ASSERT_TRUE(X0 == 111 && Y0 == 222 && Z0 == 333 && Xp == 444 && Yp == 555);
+    ASSERT_EQ_INT(1, TapMove_SolveGround(sx, sy, hy, hx, hz, &gx, &gz));
+    ASSERT_TRUE(X0 == 111 && Y0 == 222 && Z0 == 333 && Xp == 444 && Yp == 555);
+}
+
+static void test_angle_error_takes_the_short_way(void) {
+    S32 a, b, bad = 0;
+
+    ASSERT_EQ_INT(0, TapMove_AngleError(100, 100));
+    ASSERT_EQ_INT(-16, TapMove_AngleError(10, 4090)); /* across 0, not round through 2048 */
+    ASSERT_EQ_INT(16, TapMove_AngleError(4090, 10));
+    ASSERT_EQ_INT(1024, TapMove_AngleError(0, 1024));
+    ASSERT_EQ_INT(-1024, TapMove_AngleError(0, 3072));
+    ASSERT_EQ_INT(-2048, TapMove_AngleError(0, 2048)); /* dead behind: a defined side, not a coin toss */
+
+    for (a = 0; a < 4096; a += 7)
+        for (b = 0; b < 4096; b += 11) {
+            S32 e = TapMove_AngleError(a, b);
+            if (e < -2048 || e > 2047 || ((a + e) & 4095) != b)
+                bad++;
+        }
+    ASSERT_EQ_INT(0, bad);
+}
+
+static void test_aim_turns_toward_the_bearing_and_walks_when_close_to_it(void) {
+    T_TAP_STEER s;
+
+    s = TapMove_Aim(0, 1024, 0); /* the spot is a quarter turn to the side where the heading grows */
+    ASSERT_EQ_INT(1, s.turn);
+    ASSERT_EQ_INT(0, s.forward); /* turn on the spot first: do not stride off the wrong way */
+
+    s = TapMove_Aim(0, 3072, 0);
+    ASSERT_EQ_INT(-1, s.turn);
+    ASSERT_EQ_INT(0, s.forward);
+
+    s = TapMove_Aim(1000, 1010, 0); /* nearly there: no turn key, walk */
+    ASSERT_EQ_INT(0, s.turn);
+    ASSERT_EQ_INT(1, s.forward);
+
+    s = TapMove_Aim(1000, 1200, 0); /* off by 200: an arc, turning and walking at once */
+    ASSERT_EQ_INT(1, s.turn);
+    ASSERT_EQ_INT(1, s.forward);
+}
+
+static void test_aim_holds_a_turn_until_nearly_aligned_but_does_not_chase(void) {
+    T_TAP_STEER s;
+
+    s = TapMove_Aim(0, 100, 1); /* inside the band where a turn already going is kept */
+    ASSERT_EQ_INT(1, s.turn);
+    s = TapMove_Aim(0, 100, 0); /* ...and one not yet started is not begun there */
+    ASSERT_EQ_INT(0, s.turn);
+    s = TapMove_Aim(0, 20, 1); /* near enough: let go */
+    ASSERT_EQ_INT(0, s.turn);
+    s = TapMove_Aim(100, 0, 1); /* overshot into the band on the far side: stop, do not turn back */
+    ASSERT_EQ_INT(0, s.turn);
+}
+
+/* Every start, every bearing, at the frame sizes of a 60 fps and a 30 fps device (the hero turns
+ * 1024 a second while a key is held): the heading settles, and the key is pressed and released once
+ * rather than chattering. The walk animation restarts whenever the movement bits change, so chatter
+ * would be seen. */
+static void test_aim_converges_without_chatter_at_any_frame_rate(void) {
+    S32 step, start, bearing;
+    S32 worstToggles = 0, nonConverged = 0;
+
+    for (step = 17; step <= 34; step += 17)
+        for (start = 0; start < 4096; start += 37)
+            for (bearing = 0; bearing < 4096; bearing += 53) {
+                S32 beta = start, turn = 0, prev = 0, toggles = 0, frames, e;
+                for (frames = 0; frames < 400; frames++) {
+                    T_TAP_STEER s = TapMove_Aim(beta, bearing, turn);
+                    turn = s.turn;
+                    if (turn != prev) {
+                        toggles++;
+                        prev = turn;
+                    }
+                    beta = (beta + turn * step) & 4095;
+                    if (turn == 0 && s.forward)
+                        break;
+                }
+                e = TapMove_AngleError(beta, bearing);
+                if (frames >= 400 || (e < 0 ? -e : e) > 320)
+                    nonConverged++;
+                if (toggles > worstToggles)
+                    worstToggles = toggles;
+            }
+    ASSERT_EQ_INT(0, nonConverged);
+    ASSERT_TRUE(worstToggles <= 3); /* on, off, and at most one reversal */
+}
+
+int main(void) {
+    RUN_TEST(test_isometric_camera_inverts_exactly);
+    RUN_TEST(test_perspective_camera_inverts_across_the_auto_cameras_range);
+    RUN_TEST(test_a_tap_above_the_horizon_is_refused);
+    RUN_TEST(test_project_and_solve_leave_the_scratch_globals_alone);
+    RUN_TEST(test_angle_error_takes_the_short_way);
+    RUN_TEST(test_aim_turns_toward_the_bearing_and_walks_when_close_to_it);
+    RUN_TEST(test_aim_holds_a_turn_until_nearly_aligned_but_does_not_chase);
+    RUN_TEST(test_aim_converges_without_chatter_at_any_frame_rate);
+    TEST_SUMMARY();
+    return test_failures != 0;
+}
diff --git a/tests/tapmove/test_tapmove_path.cpp b/tests/tapmove/test_tapmove_path.cpp
new file mode 100644
index 0000000..9fcbda3
--- /dev/null
+++ b/tests/tapmove/test_tapmove_path.cpp
@@ -0,0 +1,349 @@
+/* Host test for tap-to-walk's route finder (SOURCES/TAPMOVE_PATH.CPP).
+ *
+ * The finder is pure -- the caller says which cells can be stood on -- so it is checked on invented
+ * maps: the hand-made ones pin the behaviour a player would notice (round a wall, stop at a wall,
+ * never cut a corner), and a sweep over thousands of random grids checks the two claims everything
+ * else rests on against a plain Dijkstra: a route that is returned is legal, and one that reaches
+ * the goal is the cheapest there is.
+ */
+#include "TAPMOVE.H"
+#include "test_harness.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define DIM 64
+
+static int g_w, g_h;
+static unsigned char g_blocked[DIM][DIM];
+static int g_startX, g_startZ;
+
+static void clear_map(int w, int h) {
+    g_w = w;
+    g_h = h;
+    memset(g_blocked, 0, sizeof(g_blocked));
+    g_startX = g_startZ = -1;
+}
+
+static S32 walkable_cb(void *ctx, S32 x, S32 z) {
+    (void)ctx;
+    return !g_blocked[z][x];
+}
+
+/* What the finder is entitled to assume: the cell the asker stands on is walkable, whatever the
+ * grid says about it. The reference below uses the same rule. */
+static int walk(int x, int z) {
+    if (x < 0 || z < 0 || x >= g_w || z >= g_h)
+        return 0;
+    if (x == g_startX && z == g_startZ)
+        return 1;
+    return !g_blocked[z][x];
+}
+
+static int step_cost(int dx, int dz) {
+    return (dx != 0 && dz != 0) ? 14 : 10;
+}
+
+/* The cost of a route, or -1 if any step of it is not a legal one. */
+static int route_cost(const S16 *x, const S16 *z, int n) {
+    int i, cost = 0;
+    for (i = 1; i < n; i++) {
+        int dx = x[i] - x[i - 1], dz = z[i] - z[i - 1];
+        if (dx < -1 || dx > 1 || dz < -1 || dz > 1 || (dx == 0 && dz == 0))
+            return -1;
+        if (!walk(x[i], z[i]))
+            return -1;
+        if (dx != 0 && dz != 0 && (!walk(x[i - 1] + dx, z[i - 1]) || !walk(x[i - 1], z[i - 1] + dz)))
+            return -1; /* cut a corner */
+        cost += step_cost(dx, dz);
+    }
+    return cost;
+}
+
+/* Reference: cheapest cost from the start to every cell, by relaxing until nothing changes. Slow
+ * and obvious, which is the point of it. */
+static void dijkstra(int sx, int sz, int dist[DIM][DIM]) {
+    static const int DX[8] = {1, -1, 0, 0, 1, 1, -1, -1};
+    static const int DZ[8] = {0, 0, 1, -1, 1, -1, 1, -1};
+    int x, z, d, changed = 1;
+
+    for (z = 0; z < DIM; z++)
+        for (x = 0; x < DIM; x++)
+            dist[z][x] = -1;
+    dist[sz][sx] = 0;
+
+    while (changed) {
+        changed = 0;
+        for (z = 0; z < g_h; z++) {
+            for (x = 0; x < g_w; x++) {
+                if (dist[z][x] < 0)
+                    continue;
+                for (d = 0; d < 8; d++) {
+                    int nx = x + DX[d], nz = z + DZ[d], c;
+                    if (!walk(nx, nz))
+                        continue;
+                    if (DX[d] != 0 && DZ[d] != 0 && (!walk(x + DX[d], z) || !walk(x, z + DZ[d])))
+                        continue;
+                    c = dist[z][x] + step_cost(DX[d], DZ[d]);
+                    if (dist[nz][nx] < 0 || c < dist[nz][nx]) {
+                        dist[nz][nx] = c;
+                        changed = 1;
+                    }
+                }
+            }
+        }
+    }
+}
+
+static int octile(int x, int z, int gx, int gz) {
+    int dx = abs(gx - x), dz = abs(gz - z), lo = dx < dz ? dx : dz;
+    return 10 * (dx + dz) - 6 * lo;
+}
+
+static S32 find(int sx, int sz, int gx, int gz, S16 *x, S16 *z, S32 *reached) {
+    g_startX = sx;
+    g_startZ = sz;
+    TapPath_Begin(walkable_cb, NULL, g_w, g_h);
+    return TapPath_Find(sx, sz, gx, gz, x, z, 600, reached);
+}
+
+static void test_open_ground_route_is_the_cheapest(void) {
+    S16 x[600], z[600];
+    S32 reached;
+    S32 n;
+
+    clear_map(16, 16);
+    n = find(2, 2, 9, 5, x, z, &reached);
+    /* three diagonals and four straights: 3 * 14 + 4 * 10 */
+    ASSERT_EQ_INT(8, n);
+    ASSERT_EQ_INT(1, reached);
+    ASSERT_EQ_INT(82, route_cost(x, z, n));
+    ASSERT_EQ_INT(2, x[0]);
+    ASSERT_EQ_INT(2, z[0]);
+    ASSERT_EQ_INT(9, x[n - 1]);
+    ASSERT_EQ_INT(5, z[n - 1]);
+}
+
+static void test_a_wall_with_a_gap_is_gone_round(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+    int i, through = 0;
+
+    clear_map(16, 16);
+    for (i = 0; i < 12; i++)
+        g_blocked[i][8] = 1; /* a wall down column 8, open from row 12 */
+    n = find(4, 5, 12, 5, x, z, &reached);
+    ASSERT_EQ_INT(1, reached);
+    for (i = 0; i < n; i++)
+        if (x[i] == 8)
+            through = (z[i] >= 12);
+    ASSERT_EQ_INT(1, through);
+    ASSERT_TRUE(route_cost(x, z, n) > 0);
+}
+
+static void test_a_goal_inside_a_wall_ends_at_the_nearest_reachable_cell(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+    int ok;
+
+    clear_map(16, 16);
+    g_blocked[6][12] = 1; /* the goal itself is solid */
+    n = find(2, 6, 12, 6, x, z, &reached);
+    ASSERT_EQ_INT(0, reached);
+    /* it walks up to the wall: the cell just short of it, on the near side */
+    ok = (x[n - 1] == 11 && z[n - 1] == 6);
+    ASSERT_EQ_INT(1, ok);
+}
+
+static void test_a_goal_walled_in_is_approached_not_entered(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+    int dx, dz, ok;
+
+    clear_map(24, 24);
+    for (dz = -1; dz <= 1; dz++)
+        for (dx = -1; dx <= 1; dx++)
+            if (dx != 0 || dz != 0)
+                g_blocked[12 + dz][12 + dx] = 1; /* a ring round (12, 12) */
+    n = find(2, 12, 12, 12, x, z, &reached);
+    ASSERT_EQ_INT(0, reached);
+    /* two cells from the goal along an axis is as close as the ring allows */
+    ok = (octile(x[n - 1], z[n - 1], 12, 12) == 20);
+    ASSERT_EQ_INT(1, ok);
+}
+
+static void test_a_diagonal_never_cuts_a_corner(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+
+    /* both neighbours of the diagonal are solid: the goal cannot be got to */
+    clear_map(4, 4);
+    g_blocked[0][1] = 1;
+    g_blocked[1][0] = 1;
+    n = find(0, 0, 1, 1, x, z, &reached);
+    ASSERT_EQ_INT(0, reached);
+    ASSERT_EQ_INT(1, n); /* boxed in: it stays where it is */
+
+    /* one is solid: the diagonal is still refused, the way round the other is taken */
+    clear_map(4, 4);
+    g_blocked[0][1] = 1;
+    n = find(0, 0, 1, 1, x, z, &reached);
+    ASSERT_EQ_INT(1, reached);
+    ASSERT_EQ_INT(3, n);
+    ASSERT_EQ_INT(0, x[1]);
+    ASSERT_EQ_INT(1, z[1]);
+}
+
+static void test_the_start_cell_is_always_walkable(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+
+    clear_map(8, 8);
+    g_blocked[3][3] = 1; /* the grid says he is inside a wall (a ramp, a doorway) */
+    n = find(3, 3, 6, 3, x, z, &reached);
+    ASSERT_EQ_INT(1, reached);
+    ASSERT_EQ_INT(4, n);
+    ASSERT_EQ_INT(3, x[0]);
+}
+
+static void test_a_goal_off_the_grid_is_the_nearest_cell_on_it(void) {
+    S16 x[600], z[600];
+    S32 reached, n;
+
+    clear_map(10, 10);
+    n = find(2, 5, 100, 5, x, z, &reached);
+    ASSERT_EQ_INT(1, reached);
+    ASSERT_EQ_INT(9, x[n - 1]);
+    ASSERT_EQ_INT(5, z[n - 1]);
+}
+
+static void test_a_route_longer_than_the_room_keeps_its_beginning(void) {
+    S16 x[4], z[4];
+    S32 reached, n;
+
+    clear_map(16, 16);
+    g_startX = 0;
+    g_startZ = 0;
+    TapPath_Begin(walkable_cb, NULL, 16, 16);
+    n = TapPath_Find(0, 0, 10, 0, x, z, 4, &reached);
+    ASSERT_EQ_INT(4, n);
+    ASSERT_EQ_INT(0, reached);
+    ASSERT_EQ_INT(0, x[0]);
+    ASSERT_EQ_INT(3, x[3]);
+}
+
+static void test_smoothing_keeps_the_ends_and_the_corners_that_matter(void) {
+    S16 x[600], z[600];
+    S32 reached, n, m, i;
+
+    /* open ground: a straight run collapses to its two ends */
+    clear_map(16, 16);
+    n = find(1, 1, 12, 1, x, z, &reached);
+    ASSERT_EQ_INT(12, n);
+    m = TapPath_Smooth(x, z, n);
+    ASSERT_EQ_INT(2, m);
+    ASSERT_EQ_INT(1, x[0]);
+    ASSERT_EQ_INT(12, x[1]);
+
+    /* a wall in the way: a corner survives, and every leg is clear */
+    clear_map(16, 16);
+    for (i = 0; i < 12; i++)
+        g_blocked[i][8] = 1;
+    n = find(4, 5, 12, 5, x, z, &reached);
+    m = TapPath_Smooth(x, z, n);
+    ASSERT_TRUE(m >= 3 && m < n);
+    ASSERT_EQ_INT(4, x[0]);
+    ASSERT_EQ_INT(12, x[m - 1]);
+    for (i = 1; i < m; i++)
+        ASSERT_TRUE(TapPath_LineClear(x[i - 1], z[i - 1], x[i], z[i]));
+}
+
+static void test_unusable_queries_are_refused(void) {
+    S16 x[4], z[4];
+    S32 reached = 5;
+
+    clear_map(8, 8);
+    TapPath_Begin(walkable_cb, NULL, 8, 8);
+    ASSERT_EQ_INT(0, TapPath_Find(-1, 0, 3, 3, x, z, 4, &reached));
+    ASSERT_EQ_INT(0, reached);
+    ASSERT_EQ_INT(0, TapPath_Find(0, 99, 3, 3, x, z, 4, &reached));
+    ASSERT_EQ_INT(0, TapPath_Find(0, 0, 3, 3, x, z, 0, &reached));
+}
+
+/* The sweep. Random grids from empty to 40% solid, 8x8 up to the 64x64 of a whole cube. */
+static unsigned g_seed = 20260622u;
+static int rnd(int n) {
+    g_seed = g_seed * 1664525u + 1013904223u;
+    return (int)((g_seed >> 8) % (unsigned)n);
+}
+
+static void test_routes_match_a_reference_on_random_grids(void) {
+    static int dist[DIM][DIM];
+    S16 x[600], z[600];
+    int iter, bad_route = 0, bad_cost = 0, bad_partial = 0, bad_smooth = 0;
+
+    for (iter = 0; iter < 1500; iter++) {
+        int w = (iter % 4 == 0) ? 64 : 8 + rnd(25);
+        int h = (iter % 4 == 0) ? 64 : 8 + rnd(25);
+        int density = (iter % 11) * 4;
+        int i, j, sx, sz, gx, gz;
+        S32 reached, n, m;
+
+        clear_map(w, h);
+        for (j = 0; j < h; j++)
+            for (i = 0; i < w; i++)
+                g_blocked[j][i] = (rnd(100) < density);
+        sx = rnd(w);
+        sz = rnd(h);
+        gx = rnd(w);
+        gz = rnd(h);
+
+        n = find(sx, sz, gx, gz, x, z, &reached);
+        if (n < 1 || x[0] != sx || z[0] != sz || route_cost(x, z, n) < 0) {
+            bad_route++;
+            continue;
+        }
+
+        dijkstra(sx, sz, dist);
+        if (dist[gz][gx] >= 0 && walk(gx, gz)) {
+            if (!reached || x[n - 1] != gx || z[n - 1] != gz || route_cost(x, z, n) != dist[gz][gx])
+                bad_cost++;
+        } else {
+            int best = 1 << 30;
+            for (j = 0; j < h; j++)
+                for (i = 0; i < w; i++)
+                    if (dist[j][i] >= 0 && octile(i, j, gx, gz) < best)
+                        best = octile(i, j, gx, gz);
+            if (reached || octile(x[n - 1], z[n - 1], gx, gz) != best)
+                bad_partial++;
+        }
+
+        m = TapPath_Smooth(x, z, n);
+        if (m < 1 || m > n || x[0] != sx || z[0] != sz)
+            bad_smooth++;
+        for (i = 1; i < m; i++)
+            if (!TapPath_LineClear(x[i - 1], z[i - 1], x[i], z[i]))
+                bad_smooth++;
+    }
+
+    ASSERT_EQ_INT(0, bad_route);
+    ASSERT_EQ_INT(0, bad_cost);
+    ASSERT_EQ_INT(0, bad_partial);
+    ASSERT_EQ_INT(0, bad_smooth);
+}
+
+int main(void) {
+    RUN_TEST(test_open_ground_route_is_the_cheapest);
+    RUN_TEST(test_a_wall_with_a_gap_is_gone_round);
+    RUN_TEST(test_a_goal_inside_a_wall_ends_at_the_nearest_reachable_cell);
+    RUN_TEST(test_a_goal_walled_in_is_approached_not_entered);
+    RUN_TEST(test_a_diagonal_never_cuts_a_corner);
+    RUN_TEST(test_the_start_cell_is_always_walkable);
+    RUN_TEST(test_a_goal_off_the_grid_is_the_nearest_cell_on_it);
+    RUN_TEST(test_a_route_longer_than_the_room_keeps_its_beginning);
+    RUN_TEST(test_smoothing_keeps_the_ends_and_the_corners_that_matter);
+    RUN_TEST(test_unusable_queries_are_refused);
+    RUN_TEST(test_routes_match_a_reference_on_random_grids);
+    TEST_SUMMARY();
+    return test_failures != 0;
+}
