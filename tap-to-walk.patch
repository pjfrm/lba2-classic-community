diff --git a/SOURCES/TAPMOVE.CPP b/SOURCES/TAPMOVE.CPP
new file mode 100644
index 0000000..9234466
--- /dev/null
+++ b/SOURCES/TAPMOVE.CPP
@@ -0,0 +1,472 @@
+/* Tap-to-walk, the half that touches the game. The design, and the reasons for
+ * it, are in TAPMOVE.H; the pure maths is in TAPMOVE_MATH.CPP. */
+
+#include "TAPMOVE.H"
+
+#include "C_EXTERN.H"
+#include "CONTROL.H"
+#include "GRILLE.H"
+#include "INPUT.H"
+#include "RECORD.H"
+
+#include <3D/GETANG2D.H>
+#include <PLATFORM/PLATFORM.H>
+#include <SVGA/SCREEN.H>
+#include <SYSTEM/TIMER.H>
+
+#include <math.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* How close counts as arrived: a third of a brick. Tight enough that he stops
+ * where the finger was, loose enough that a hero who cannot quite reach the exact
+ * point (a narrow gap, a ledge) is not left walking on the spot. */
+#define TAP_ARRIVE_RADIUS 170
+
+/* A waypoint on the way is passed at this distance: a little over half a brick, so
+ * the hero rounds a corner instead of walking up to its exact centre and then
+ * having to turn on the spot. */
+#define TAP_WAYPOINT_RADIUS 260
+
+/* While a finger is held and drags the destination across the floor, the route is
+ * worked out again when it enters another cell, but no more often than this (game
+ * clock, ms). */
+#define TAP_REPLAN_MS 150
+
+/* The most waypoints one route keeps. A cube is 64 x 64 bricks and smoothing
+ * leaves a handful of corners, so this is a ceiling, not an expectation. */
+#define TAP_MAX_WP 160
+
+/* A tap further than this from the hero is pulled back along the line to it
+ * (about 47 bricks: past anything that is on screen with the camera zoomed out). */
+#define TAP_MAX_DIST 24000
+
+/* No gameplay frame for this long (wall clock) means a modal screen, a pause or a
+ * load was up. The walk is dropped on the way back rather than resumed: the
+ * player's intent was about a scene that has since changed. */
+#define TAP_RESUME_GAP_MS 250
+
+/* Game clock. One order may not walk longer than this, whatever else happens. */
+#define TAP_MAX_WALK_MS 20000
+
+/* Blocked detection, on the game clock: over a window in which the hero spent most
+ * of the time holding forward, he must have covered at least MIN_MOVE units, or
+ * that is a strike. The first strike plans the route again from where he stands (the
+ * grid can be wrong about a door, a pushed block, somebody standing in the way);
+ * a second in a row drops the order. */
+#define TAP_STUCK_WINDOW_MS 450
+#define TAP_STUCK_MIN_MOVE 70
+#define TAP_STUCK_STRIKES 2
+
+typedef struct {
+    S32 active;  /* a destination is set */
+    S32 down;    /* the finger that gave it is still on the glass */
+    S32 fresh;   /* a touch has arrived since the destination was last worked out */
+    S32 restart; /* the next resolve starts a new order: reset the timers */
+
+    float nx, ny; /* the finger, game-normalised */
+
+    S32 tx, ty, tz; /* the tapped spot, world */
+    S32 turn;       /* TapMove_Aim's memory of last frame's turn */
+
+    S32 wpX[TAP_MAX_WP]; /* the route: waypoints, world; the last is the destination */
+    S32 wpZ[TAP_MAX_WP];
+    S32 wpN, wpI;       /* how many, and which one the hero is heading for */
+    S32 planned;        /* wpX/wpZ hold a route for the current destination */
+    S32 replan;         /* plan again at the next opportunity */
+    S32 partial;        /* the route ends short of the tapped spot (it is walled off) */
+    S32 planCx, planCz; /* the destination's cell when the route was planned */
+    U32 planMs;         /* game clock when it was planned */
+
+    U32 startMs;    /* game clock: when this order began */
+    U32 sampleMs;   /* game clock: start of the current blocked-detection window */
+    U32 lastGameMs; /* game clock at the previous TapMove_Steer */
+    S32 sampleX, sampleZ;
+    S32 walkedMs; /* time spent holding forward in this window */
+    S32 strikes;
+
+    U32 lastFrameMs; /* wall clock at the previous TapMove_Steer; 0 = never */
+
+    S32 markerOk;
+    S32 markerX, markerY;
+} T_TAPMOVE;
+
+static T_TAPMOVE s_tap;
+
+S32 TouchTapToMove = 1;
+
+static U32 WallMs(void) {
+    return (U32)g_platform.system.ticks_ms();
+}
+
+/* Gameplay is running if the main loop has asked us for steering recently. Every
+ * modal screen runs its own inner loop and never gets here, so the absence of
+ * calls is the signal -- no per-screen mode stack needed. */
+static S32 GameplayRunning(void) {
+    return s_tap.lastFrameMs != 0 && (U32)(WallMs() - s_tap.lastFrameMs) <= TAP_RESUME_GAP_MS;
+}
+
+S32 TapMove_IsEnabled(void) {
+    return TouchTapToMove ? 1 : 0;
+}
+
+S32 TapMove_ReplacesDpad(void) {
+    return TapMove_IsEnabled() && GameplayRunning();
+}
+
+void TapMove_Cancel(void) {
+    s_tap.active = 0;
+    s_tap.down = 0;
+    s_tap.fresh = 0;
+    s_tap.restart = 0;
+    s_tap.turn = 0;
+    s_tap.strikes = 0;
+    s_tap.walkedMs = 0;
+    s_tap.planned = 0;
+    s_tap.replan = 0;
+    s_tap.wpN = 0;
+    s_tap.wpI = 0;
+    s_tap.markerOk = 0;
+}
+
+S32 TapMove_Touch(float nx, float ny, S32 phase) {
+    if (!TapMove_IsEnabled())
+        return 0;
+
+    switch (phase) {
+    case TAPMOVE_FINGER_DOWN:
+        /* A tap on a dialogue, a menu or a loading screen is not a walk order:
+           queueing it would send the hero off the moment the screen closed. */
+        if (!GameplayRunning())
+            return 0;
+        s_tap.nx = nx;
+        s_tap.ny = ny;
+        s_tap.down = 1;
+        s_tap.fresh = 1;
+        s_tap.restart = 1;
+        return 1;
+
+    case TAPMOVE_FINGER_MOVE:
+        if (!s_tap.down)
+            return 0;
+        s_tap.nx = nx;
+        s_tap.ny = ny;
+        s_tap.fresh = 1;
+        return 1;
+
+    case TAPMOVE_FINGER_UP:
+        if (!s_tap.down)
+            return 0;
+        /* The order stands: a tap is "go there", it does not end with the lift. */
+        s_tap.down = 0;
+        return 1;
+    }
+    return 0;
+}
+
+S32 TapMove_GetMarker(S32 *sx, S32 *sy) {
+    if (!s_tap.active || !s_tap.markerOk)
+        return 0;
+    *sx = s_tap.markerX;
+    *sy = s_tap.markerY;
+    return 1;
+}
+
+/* The finger -> a point on the floor at the hero's feet, through the camera the
+ * frame was drawn with. Returns 0 for a tap that is not on the ground (the sky,
+ * behind the camera). */
+static S32 ResolveFinger(const T_OBJET *hero, S32 *gx, S32 *gz) {
+    if (ModeDesiredX == 0 || ModeDesiredY == 0)
+        return 0;
+
+    const S32 px = (S32)(s_tap.nx * (float)ModeDesiredX + 0.5f);
+    const S32 py = (S32)(s_tap.ny * (float)ModeDesiredY + 0.5f);
+
+    if (!TapMove_SolveGround(px, py, hero->Obj.Y, hero->Obj.X, hero->Obj.Z, gx, gz))
+        return 0;
+
+    const double dx = (double)(*gx - hero->Obj.X);
+    const double dz = (double)(*gz - hero->Obj.Z);
+    const double dist = sqrt(dx * dx + dz * dz);
+    if (dist > (double)TAP_MAX_DIST) {
+        *gx = hero->Obj.X + (S32)(dx * (double)TAP_MAX_DIST / dist);
+        *gz = hero->Obj.Z + (S32)(dz * (double)TAP_MAX_DIST / dist);
+    }
+    return 1;
+}
+
+/* The ring goes where the route ends: the tapped spot, or the nearest the hero can
+ * get to it when that is walled off. */
+static void UpdateMarker(void) {
+    if (s_tap.wpN < 1) {
+        s_tap.markerOk = 0;
+        return;
+    }
+    s_tap.markerOk = TapMove_Project(s_tap.wpX[s_tap.wpN - 1], s_tap.ty, s_tap.wpZ[s_tap.wpN - 1], &s_tap.markerX,
+                                     &s_tap.markerY)
+                         ? 1
+                         : 0;
+}
+
+static S64 DistSq(S32 dx, S32 dz) {
+    return (S64)dx * (S64)dx + (S64)dz * (S64)dz;
+}
+
+/* ---- Routes -------------------------------------------------------------- */
+
+typedef struct {
+    S32 y;    /* the hero's feet: the floor the route is on */
+    S32 ymax; /* his height: what has to be clear above it */
+} T_WALK_CTX;
+
+/* Can the hero stand in this cell of the grid? The same two questions the
+ * engine asks when it moves him: is the column at his height free (a result of
+ * 1 is a solid brick; ramps and stairs are other codes and can be walked), and is
+ * there a brick under his feet to stand on, so a route does not lead off a ledge or
+ * across a hole. */
+static S32 CellWalkable(void *vctx, S32 cx, S32 cz) {
+    const T_WALK_CTX *c = (const T_WALK_CTX *)vctx;
+    const S32 x = cx * SIZE_BRICK_XZ + SIZE_BRICK_XZ / 2;
+    const S32 z = cz * SIZE_BRICK_XZ + SIZE_BRICK_XZ / 2;
+
+    /* The probes leave the cell they looked at in these. */
+    const S32 saveX = XMap, saveY = YMap, saveZ = ZMap;
+
+    S32 ok = (WorldColBrickFull(x, c->y, z, c->ymax) != 1);
+    if (ok && c->y > 0)
+        ok = (WorldColBrick(x, c->y - 1, z) != 0);
+
+    XMap = saveX;
+    YMap = saveY;
+    ZMap = saveZ;
+    return ok;
+}
+
+static S32 ClampCell(S32 v) {
+    return v < 0 ? 0 : (v >= SIZE_CUBE_X ? SIZE_CUBE_X - 1 : v);
+}
+
+/* Fill the route from the hero to the tapped spot, round whatever is in between.
+ * Returns the number of waypoints, or 0 when there is nothing better than walking
+ * straight at it: not an interior (an island is not on the brick grid), the hero
+ * and the spot in one cell, or no usable route. */
+static S32 BuildRoute(const T_OBJET *hero) {
+    if (CubeMode != CUBE_INTERIEUR)
+        return 0;
+
+    const S32 sx = hero->Obj.X >> 9;
+    const S32 sz = hero->Obj.Z >> 9;
+    if (sx < 0 || sx >= SIZE_CUBE_X || sz < 0 || sz >= SIZE_CUBE_Z)
+        return 0;
+
+    const S32 gx = ClampCell(s_tap.tx >> 9);
+    const S32 gz = ClampCell(s_tap.tz >> 9);
+    if (sx == gx && sz == gz)
+        return 0;
+
+    T_WALK_CTX ctx;
+    ctx.y = hero->Obj.Y;
+    ctx.ymax = hero->YMax;
+
+    S16 cx[TAP_MAX_WP], cz[TAP_MAX_WP];
+    S32 reached = 0;
+    TapPath_Begin(CellWalkable, &ctx, SIZE_CUBE_X, SIZE_CUBE_Z);
+    S32 n = TapPath_Find(sx, sz, gx, gz, cx, cz, TAP_MAX_WP, &reached);
+    if (n < 2)
+        return 0;
+    n = TapPath_Smooth(cx, cz, n);
+
+    /* The hero is already in the first cell: the route is the ones after it. */
+    S32 k = 0;
+    for (S32 i = 1; i < n && k < TAP_MAX_WP; i++) {
+        s_tap.wpX[k] = cx[i] * SIZE_BRICK_XZ + SIZE_BRICK_XZ / 2;
+        s_tap.wpZ[k] = cz[i] * SIZE_BRICK_XZ + SIZE_BRICK_XZ / 2;
+        k++;
+    }
+
+    s_tap.partial = reached ? 0 : 1;
+    if (reached && (s_tap.tx >> 9) == gx && (s_tap.tz >> 9) == gz) {
+        /* End on the spot that was touched, not the middle of its cell. */
+        s_tap.wpX[k - 1] = s_tap.tx;
+        s_tap.wpZ[k - 1] = s_tap.tz;
+    }
+    return k;
+}
+
+static void PlanRoute(const T_OBJET *hero, U32 gameNow) {
+    s_tap.partial = 0;
+    S32 n = BuildRoute(hero);
+    if (n == 0) {
+        s_tap.wpX[0] = s_tap.tx;
+        s_tap.wpZ[0] = s_tap.tz;
+        n = 1;
+        s_tap.partial = 0;
+    }
+    s_tap.wpN = n;
+    s_tap.wpI = 0;
+    s_tap.planned = 1;
+    s_tap.replan = 0;
+    s_tap.planCx = s_tap.tx >> 9;
+    s_tap.planCz = s_tap.tz >> 9;
+    s_tap.planMs = gameNow;
+}
+
+U32 TapMove_Steer(void) {
+    const U32 wallNow = WallMs();
+    const S32 resumed = s_tap.lastFrameMs != 0 && (U32)(wallNow - s_tap.lastFrameMs) > TAP_RESUME_GAP_MS;
+    s_tap.lastFrameMs = wallNow;
+
+    const U32 gameNow = TimerRefHR;
+    const S32 frameMs = (S32)(gameNow - s_tap.lastGameMs);
+    s_tap.lastGameMs = gameNow;
+
+    /* Back from a modal screen, a pause or a load. */
+    if (resumed)
+        TapMove_Cancel();
+
+    /* A replay already carries the bits this produced, and the scripted harness
+       drives the hero itself; adding ours would double-drive him. Demo reels are
+       not playable. */
+    if (!TapMove_IsEnabled() || DemoSlide || Control_IsActive() || Record_IsReplaying()) {
+        TapMove_Cancel();
+        return 0;
+    }
+
+    const T_OBJET *hero = &ListObjet[NUM_PERSO];
+
+    /* Only while the player really has the hero: a cutscene or a script moves him
+       on a track, and a dead hero walks nowhere. */
+    if (hero->Move != MOVE_MANUAL || hero->Obj.Body.Num == -1 || hero->LifePoint <= 0) {
+        TapMove_Cancel();
+        return 0;
+    }
+
+    if (!s_tap.active && !s_tap.fresh && !s_tap.down)
+        return 0;
+
+    /* Real movement input (keyboard, pad) always wins over a walk order. Input
+       holds only what was read from real devices so far this frame. */
+    if (Input & I_JOY) {
+        TapMove_Cancel();
+        return 0;
+    }
+
+    /* Work out where the finger is. While it is down this runs every frame, not
+       only when it moves: the camera follows the hero, so a finger that does not
+       move still points at a different piece of floor from one frame to the next. */
+    if (s_tap.fresh || s_tap.down) {
+        S32 gx, gz;
+        s_tap.fresh = 0;
+        if (ResolveFinger(hero, &gx, &gz)) {
+            s_tap.tx = gx;
+            s_tap.tz = gz;
+            s_tap.ty = hero->Obj.Y;
+            if (!s_tap.active || s_tap.restart) {
+                s_tap.active = 1;
+                s_tap.planned = 0; /* a new order: a new route */
+                s_tap.turn = 0;
+                s_tap.strikes = 0;
+                s_tap.walkedMs = 0;
+                s_tap.startMs = gameNow;
+                s_tap.sampleMs = gameNow;
+                s_tap.sampleX = hero->Obj.X;
+                s_tap.sampleZ = hero->Obj.Z;
+            }
+            s_tap.restart = 0;
+        } else if (s_tap.restart) {
+            /* The tap that started this was not on the ground: nothing to walk to. */
+            s_tap.restart = 0;
+            if (!s_tap.active)
+                s_tap.down = 0;
+        }
+    }
+
+    if (!s_tap.active)
+        return 0;
+
+    /* Plan the route to where the finger points, or plan it again: the finger
+       moved to another cell (a held finger drags the destination about), or the
+       hero was found to be blocked. Inside the same cell the last waypoint just
+       follows the finger. */
+    {
+        const S32 moved = (s_tap.tx >> 9) != s_tap.planCx || (s_tap.tz >> 9) != s_tap.planCz;
+        if (!s_tap.planned || s_tap.replan || (moved && (U32)(gameNow - s_tap.planMs) >= (U32)TAP_REPLAN_MS)) {
+            PlanRoute(hero, gameNow);
+        } else if (!s_tap.partial && !moved && s_tap.wpN > 0) {
+            s_tap.wpX[s_tap.wpN - 1] = s_tap.tx;
+            s_tap.wpZ[s_tap.wpN - 1] = s_tap.tz;
+        }
+    }
+
+    /* Pass the waypoints already reached; the last one is the destination. */
+    while (s_tap.wpI < s_tap.wpN - 1 &&
+           DistSq(s_tap.wpX[s_tap.wpI] - hero->Obj.X, s_tap.wpZ[s_tap.wpI] - hero->Obj.Z) <=
+               (S64)TAP_WAYPOINT_RADIUS * (S64)TAP_WAYPOINT_RADIUS)
+        s_tap.wpI++;
+
+    const S32 aimX = s_tap.wpX[s_tap.wpI];
+    const S32 aimZ = s_tap.wpZ[s_tap.wpI];
+    const S32 isLast = (s_tap.wpI == s_tap.wpN - 1);
+
+    UpdateMarker();
+
+    const S32 arrived =
+        isLast && DistSq(aimX - hero->Obj.X, aimZ - hero->Obj.Z) <= (S64)TAP_ARRIVE_RADIUS * (S64)TAP_ARRIVE_RADIUS;
+
+    /* A held finger keeps the order alive (the hero waits where it points); a
+       lifted one ends it on arrival or when it has been going on too long. */
+    if (!s_tap.down) {
+        if (arrived || (U32)(gameNow - s_tap.startMs) > (U32)TAP_MAX_WALK_MS) {
+            TapMove_Cancel();
+            return 0;
+        }
+    }
+    if (arrived) {
+        s_tap.turn = 0;
+        return 0;
+    }
+
+    /* Blocked? */
+    if ((U32)(gameNow - s_tap.sampleMs) >= (U32)TAP_STUCK_WINDOW_MS) {
+        const S32 mx = hero->Obj.X - s_tap.sampleX;
+        const S32 mz = hero->Obj.Z - s_tap.sampleZ;
+        const S32 spentWalking = s_tap.walkedMs * 4 >= TAP_STUCK_WINDOW_MS * 3;
+        if (spentWalking && DistSq(mx, mz) < (S64)TAP_STUCK_MIN_MOVE * (S64)TAP_STUCK_MIN_MOVE)
+            s_tap.strikes++;
+        else
+            s_tap.strikes = 0;
+        s_tap.sampleMs = gameNow;
+        s_tap.sampleX = hero->Obj.X;
+        s_tap.sampleZ = hero->Obj.Z;
+        s_tap.walkedMs = 0;
+        if (s_tap.strikes >= TAP_STUCK_STRIKES) {
+            TapMove_Cancel();
+            return 0;
+        }
+        if (s_tap.strikes > 0)
+            s_tap.replan = 1; /* the first strike: look for another way from here */
+    }
+
+    const S32 bearing = GetAngle2D(hero->Obj.X, hero->Obj.Z, aimX, aimZ);
+    const T_TAP_STEER st = TapMove_Aim(hero->Obj.Beta & 4095, bearing, s_tap.turn);
+    s_tap.turn = st.turn;
+
+    U32 bits = 0;
+    if (st.turn > 0)
+        bits |= I_LEFT; /* the heading grows while I_LEFT is held (ManualRealAngle) */
+    else if (st.turn < 0)
+        bits |= I_RIGHT;
+    if (st.forward) {
+        bits |= I_UP;
+        /* A hitch in the frame clock must not count as a long walk. */
+        if (frameMs > 0 && frameMs < 100)
+            s_tap.walkedMs += frameMs;
+    }
+    return bits;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/SOURCES/TAPMOVE.H b/SOURCES/TAPMOVE.H
new file mode 100644
index 0000000..49475d8
--- /dev/null
+++ b/SOURCES/TAPMOVE.H
@@ -0,0 +1,160 @@
+#pragma once
+
+#include <SYSTEM/ADELINE_TYPES.H>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Tap-to-walk for the touch overlay.
+ *
+ * Touch the empty part of the screen and Twinsen walks to that spot; keep the
+ * finger down and he follows it. The D-pad this replaces made the player steer
+ * a tank (turn, then walk) with two thumbs on a glass screen, which is the part
+ * of the 1997 controls that suits a touchscreen least.
+ *
+ * HOW IT WORKS
+ * ------------
+ * It does not move the hero. It presses the same keys a player would: each
+ * gameplay frame TapMove_Steer returns I_UP / I_LEFT / I_RIGHT bits that are ORed
+ * into Input, right where the replay harness already ORs its own. Everything
+ * after that -- animations, speed, collisions, climbing, swimming, the
+ * behaviour modes -- is the engine's existing manual-movement code, untouched.
+ *
+ * A tap becomes a spot on the ground by inverting the live camera: the engine's
+ * own world->screen projection (LongWorldRotatePoint + LongProjectPoint, the
+ * pair every actor label and shadow goes through) is solved for the point on the
+ * floor, at the hero's feet height, that lands under the finger. Doing it through
+ * the projection the game is drawing with, rather than re-deriving the camera,
+ * is what makes it right for the classic isometric rooms and the perspective
+ * Auto camera alike.
+ *
+ * The steering itself (TapMove_Aim) is a pure function of the hero's heading and
+ * the bearing to the spot, with hysteresis so a held turn key is not toggled every
+ * frame -- the manual-movement code restarts the walk animation whenever the
+ * movement bits change.
+ *
+ * WHAT STOPS IT
+ * -------------
+ * Arrival; a new tap; any real movement input (pad, keyboard); the hero leaving
+ * manual control (cutscene, script, death); a modal screen (dialogue, menu,
+ * inventory: they run their own loops, so TapMove_Steer simply stops being
+ * called and the walk is dropped when it resumes); being blocked for about a
+ * second; and a ceiling on how long one walk may last.
+ *
+ * It is off during replays and the scripted harness: a recording already holds the
+ * bits this produced, and generating them again would double-drive the hero.
+ *
+ * Setting: TouchTapToMove in lba2.cfg / touch_tap_move on the console (default on;
+ * 0 brings the on-screen D-pad back).
+ */
+
+/* ---------------------------------------------------------------------------
+ * Pure helpers (TAPMOVE_MATH.CPP). No game state beyond the camera globals the
+ * projection already reads, so they are unit tested on their own.
+ * --------------------------------------------------------------------------- */
+
+/* Steering decision for one frame. */
+typedef struct {
+    S32 turn;    /* +1: heading must grow (hold I_LEFT), -1: shrink (I_RIGHT), 0: hold */
+    S32 forward; /* 1: hold I_UP */
+} T_TAP_STEER;
+
+/* Signed shortest angle from `beta` to `bearing`, in 1/4096 turn units, in
+ * [-2048, 2047]. Positive means the heading has to grow. */
+S32 TapMove_AngleError(S32 beta, S32 bearing);
+
+/* One frame of steering. `prevTurn` is last frame's `turn`: it is the memory the
+ * hysteresis needs to keep a turn going until the heading is nearly right instead
+ * of releasing it the moment the error dips under the threshold that started it. */
+T_TAP_STEER TapMove_Aim(S32 beta, S32 bearing, S32 prevTurn);
+
+/* World point -> screen pixel with the camera and projection the game is drawing
+ * with, leaving the projection's scratch globals (X0, Y0, Z0, Xp, Yp) as they
+ * were. Returns 0 when the point is not on screen (behind the camera). */
+S32 TapMove_Project(S32 x, S32 y, S32 z, S32 *sx, S32 *sy);
+
+/* The point on the horizontal plane y = groundY that the live camera projects to
+ * the screen pixel (px, py), in the same logical pixels the projection uses.
+ * (startX, startZ) seeds the search; the hero's own position is the natural seed.
+ * Returns 1 and fills *outX / *outZ, or 0 when there is no such point on screen
+ * (above the horizon, behind the camera) or the answer does not hold up when
+ * projected back. */
+S32 TapMove_SolveGround(S32 px, S32 py, S32 groundY, S32 startX, S32 startZ, S32 *outX, S32 *outZ);
+
+/* ---------------------------------------------------------------------------
+ * Route finding (TAPMOVE_PATH.CPP): A* on the cell grid of an interior cube, so a
+ * tap on the far side of a wall walks round it instead of into it. Pure: the
+ * caller says which cells can be stood on.
+ *
+ * A query is TapPath_Begin, then TapPath_Find, then (optionally) TapPath_Smooth,
+ * which reuses what Find learned about the grid.
+ * --------------------------------------------------------------------------- */
+
+/* The largest grid it will search: an interior cube is 64 x 64 bricks. */
+#define TAPPATH_GRID_MAX 64
+
+/* Can a hero stand in cell (cx, cz)? */
+typedef S32 (*T_TAP_WALKABLE)(void *ctx, S32 cx, S32 cz);
+
+void TapPath_Begin(T_TAP_WALKABLE walkable, void *ctx, S32 gridW, S32 gridH);
+
+/* The cheapest route from (sx, sz) to (gx, gz) over 8-connected cells, no corner
+ * cutting, written start first into outX / outZ (room for maxOut cells). Returns
+ * the number of cells, 0 if the query is unusable. *reachedGoal is 1 if the last
+ * cell is the goal. If the goal cannot be reached (it is a wall, or walled in)
+ * the route ends at the reachable cell nearest to it: walk as close as you can.
+ * The start cell is always taken as walkable. */
+S32 TapPath_Find(S32 sx, S32 sz, S32 gx, S32 gz, S16 *outX, S16 *outZ, S32 maxOut, S32 *reachedGoal);
+
+/* Whether a straight run between two cells stays on walkable ones (and cuts no
+ * corner). */
+S32 TapPath_LineClear(S32 ax, S32 az, S32 bx, S32 bz);
+
+/* Drops the cells of a route that a straight line can skip, in place, keeping
+ * both ends. Returns the new count. */
+S32 TapPath_Smooth(S16 *x, S16 *z, S32 n);
+
+/* ---------------------------------------------------------------------------
+ * Game side (TAPMOVE.CPP)
+ * --------------------------------------------------------------------------- */
+
+#define TAPMOVE_FINGER_DOWN 0
+#define TAPMOVE_FINGER_MOVE 1
+#define TAPMOVE_FINGER_UP 2
+
+/* The TouchTapToMove setting (lba2.cfg key, touch_tap_move on the console): 1 = a
+ * touch on empty glass walks there, 0 = the on-screen D-pad, as before. Defined in
+ * TAPMOVE.CPP with the rest of the module's state; CONFIG_FILE.CPP lists it. */
+extern S32 TouchTapToMove;
+
+/* Whether the player has tap-to-walk on. */
+S32 TapMove_IsEnabled(void);
+
+/* Whether the overlay should leave the D-pad out right now: tap-to-walk is on
+ * AND gameplay is running. Two ways to steer on one screen is the clutter this
+ * exists to remove -- but menus, the inventory and the save list are still driven
+ * by direction keys, and on a touchscreen the D-pad is the only way to press them,
+ * so it comes back whenever a modal screen is up (no gameplay frame for a moment). */
+S32 TapMove_ReplacesDpad(void);
+
+/* A finger on empty glass. nx, ny are game-area normalised (0..1), the space
+ * TOUCH_INPUT.CPP's MapToGameCoords produces. Returns 1 if the touch was taken as
+ * a walk order, 0 if it was ignored (feature off, or no gameplay running: a tap
+ * on a dialogue or a menu must not queue a walk for after it closes). */
+S32 TapMove_Touch(float nx, float ny, S32 phase);
+
+/* Drop the current walk. */
+void TapMove_Cancel(void);
+
+/* Once per gameplay frame, after the real input has been read and before the
+ * simulation runs. Returns the movement bits to OR into Input. */
+U32 TapMove_Steer(void);
+
+/* Where the current destination is on screen, in logical pixels, for the
+ * overlay to mark. Returns 0 when there is no walk in progress. */
+S32 TapMove_GetMarker(S32 *sx, S32 *sy);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/SOURCES/TAPMOVE_MATH.CPP b/SOURCES/TAPMOVE_MATH.CPP
new file mode 100644
index 0000000..52baa42
--- /dev/null
+++ b/SOURCES/TAPMOVE_MATH.CPP
@@ -0,0 +1,166 @@
+/* The pure half of tap-to-walk: nothing here reads the game, only the camera the
+ * projection already holds. See TAPMOVE.H for the whole design. */
+
+#include "TAPMOVE.H"
+
+#include <3D/CAMERA.H>
+#include <3D/DATAMAT.H>
+#include <3D/LPROJ.H>
+#include <3D/LROT3D.H>
+
+#include <math.h>
+
+/* Steering thresholds, in 1/4096 of a turn.
+ *
+ * The hero turns at 1024 units a second while a turn key is held, so a frame at
+ * 30 fps moves the heading by about 34. TURN_OFF has to be wider than that or the
+ * heading would hop across the dead band and the key would chatter; TURN_ON is
+ * wider again so that a heading that has just settled is not set turning by the
+ * first stray frame. WALK_CONE is how far off the bearing the hero may be and
+ * still walk: inside it he walks an arc towards the spot, outside it he turns on
+ * the spot first, which keeps him from striding off in the wrong direction. */
+#define TAP_TURN_ON 128
+#define TAP_TURN_OFF 48
+#define TAP_WALK_CONE 320
+
+/* The solver's finite-difference probe, in world units (half a brick), the
+ * largest single correction it may take, and how many it gets. */
+#define TAP_PROBE 256
+#define TAP_MAX_STEP 4096.0
+#define TAP_SOLVE_ITERS 14
+
+/* How far, in pixels, the answer may land from the finger and still count. The
+ * isometric projection quantises to whole pixels, so ~1 is the floor. */
+#define TAP_CONVERGED_PX 1.0
+#define TAP_ACCEPT_PX 2.0
+
+/* Round to nearest, halves away from zero. The project builds as C++98, which has no lround. */
+static S32 Round(double v) {
+    return (S32)(v < 0.0 ? v - 0.5 : v + 0.5);
+}
+
+S32 TapMove_AngleError(S32 beta, S32 bearing) {
+    return (((bearing - beta) + 2048) & 4095) - 2048;
+}
+
+T_TAP_STEER TapMove_Aim(S32 beta, S32 bearing, S32 prevTurn) {
+    const S32 e = TapMove_AngleError(beta, bearing);
+    const S32 ae = (e < 0) ? -e : e;
+    T_TAP_STEER s;
+
+    s.turn = prevTurn;
+    if (ae > TAP_TURN_ON) {
+        s.turn = (e > 0) ? 1 : -1;
+    } else if (ae < TAP_TURN_OFF) {
+        s.turn = 0;
+    } else if (s.turn != 0 && ((e > 0) != (s.turn > 0))) {
+        /* Overshot into the dead band on the far side: stop, do not chase it. */
+        s.turn = 0;
+    }
+    s.forward = (ae < TAP_WALK_CONE) ? 1 : 0;
+    return s;
+}
+
+/* World point -> screen pixel with the camera and projection the game is drawing
+ * with. The same pair of calls every label, shadow and flow particle uses, so it
+ * is right for the isometric rooms and the perspective camera alike. */
+static S32 ProjectWorld(S32 x, S32 y, S32 z, S32 *sx, S32 *sy) {
+    LongWorldRotatePoint(x, y, z);
+    if (!LongProjectPoint(X0, Y0, Z0))
+        return 0;
+    *sx = Xp;
+    *sy = Yp;
+    return 1;
+}
+
+S32 TapMove_Project(S32 x, S32 y, S32 z, S32 *sx, S32 *sy) {
+    const S32 saveX0 = X0, saveY0 = Y0, saveZ0 = Z0, saveXp = Xp, saveYp = Yp;
+    const S32 ok = ProjectWorld(x, y, z, sx, sy);
+    X0 = saveX0;
+    Y0 = saveY0;
+    Z0 = saveZ0;
+    Xp = saveXp;
+    Yp = saveYp;
+    return ok;
+}
+
+S32 TapMove_SolveGround(S32 px, S32 py, S32 groundY, S32 startX, S32 startZ, S32 *outX, S32 *outZ) {
+    /* The projection leaves its result in these scratch globals. Nothing is
+     * supposed to rely on them across a frame boundary, but whoever called us
+     * did not ask for them to change. */
+    const S32 saveX0 = X0, saveY0 = Y0, saveZ0 = Z0, saveXp = Xp, saveYp = Yp;
+
+    double x = (double)startX;
+    double z = (double)startZ;
+    S32 ok = 0;
+
+    /* Newton's method on the two-variable map (x, z) -> (pixel x, pixel y) at a
+     * fixed height. The Jacobian comes from probing the projection itself, so
+     * there is no camera model to keep in step with the engine's: for the
+     * isometric camera the map is affine and one step lands it; for the
+     * perspective camera it is a homography and a few steps do. */
+    for (S32 it = 0; it < TAP_SOLVE_ITERS; it++) {
+        const S32 xi = Round(x);
+        const S32 zi = Round(z);
+        S32 sx, sy, ax, ay, bx, by;
+
+        if (!ProjectWorld(xi, groundY, zi, &sx, &sy))
+            break;
+
+        const double ex = (double)px - (double)sx;
+        const double ey = (double)py - (double)sy;
+        if (fabs(ex) <= TAP_CONVERGED_PX && fabs(ey) <= TAP_CONVERGED_PX) {
+            ok = 1;
+            break;
+        }
+
+        if (!ProjectWorld(xi + TAP_PROBE, groundY, zi, &ax, &ay) ||
+            !ProjectWorld(xi, groundY, zi + TAP_PROBE, &bx, &by))
+            break;
+
+        const double a = (double)(ax - sx) / TAP_PROBE;
+        const double b = (double)(bx - sx) / TAP_PROBE;
+        const double c = (double)(ay - sy) / TAP_PROBE;
+        const double d = (double)(by - sy) / TAP_PROBE;
+        const double det = a * d - b * c;
+        if (fabs(det) < 1e-12)
+            break;
+
+        double dx = (d * ex - b * ey) / det;
+        double dz = (a * ey - c * ex) / det;
+        const double len = sqrt(dx * dx + dz * dz);
+        if (!(len == len)) /* NaN */
+            break;
+        if (len > TAP_MAX_STEP) {
+            dx *= TAP_MAX_STEP / len;
+            dz *= TAP_MAX_STEP / len;
+        }
+        x += dx;
+        z += dz;
+    }
+
+    S32 rx = Round(x);
+    S32 rz = Round(z);
+
+    /* Out of iterations is not the same as wrong: take the last point if it
+     * projects back to within a couple of pixels of the finger. A point that does
+     * not (above the horizon, behind the camera) is refused. */
+    if (!ok) {
+        S32 sx, sy;
+        if (ProjectWorld(rx, groundY, rz, &sx, &sy) &&
+            fabs((double)px - (double)sx) <= TAP_ACCEPT_PX && fabs((double)py - (double)sy) <= TAP_ACCEPT_PX)
+            ok = 1;
+    }
+
+    X0 = saveX0;
+    Y0 = saveY0;
+    Z0 = saveZ0;
+    Xp = saveXp;
+    Yp = saveYp;
+
+    if (!ok)
+        return 0;
+    *outX = rx;
+    *outZ = rz;
+    return 1;
+}
diff --git a/SOURCES/TAPMOVE_PATH.CPP b/SOURCES/TAPMOVE_PATH.CPP
new file mode 100644
index 0000000..8e511d2
--- /dev/null
+++ b/SOURCES/TAPMOVE_PATH.CPP
@@ -0,0 +1,259 @@
+/* Route finding for tap-to-walk, on the brick grid of an interior cube. The
+ * design, and where this fits, are in TAPMOVE.H.
+ *
+ * Pure: it knows nothing of the game. The caller says which cells can be stood on
+ * through a callback, which is what lets it be tested on invented maps. */
+
+#include "TAPMOVE.H"
+
+#include <string.h>
+
+#define PATH_DIM TAPPATH_GRID_MAX
+#define PATH_NODES (PATH_DIM * PATH_DIM)
+
+/* Integer costs of an orthogonal step and a diagonal one (1 : sqrt 2 to 1%). */
+#define COST_ORTH 10
+#define COST_DIAG 14
+
+/* A node can be pushed again each time a cheaper way to it is found; eight
+ * neighbours is the most a node can be relaxed from. */
+#define HEAP_MAX (PATH_NODES * 8)
+
+static T_TAP_WALKABLE s_walkable;
+static void *s_ctx;
+static S32 s_w, s_h;
+
+static U8 s_known[PATH_NODES]; /* 0 = not asked yet, 1 = walkable, 2 = blocked */
+static U8 s_state[PATH_NODES]; /* 0 = unseen, 1 = open, 2 = closed */
+static S32 s_g[PATH_NODES];
+static S32 s_f[PATH_NODES];
+static S16 s_parent[PATH_NODES];
+
+static S32 s_heapF[HEAP_MAX];
+static S16 s_heapN[HEAP_MAX];
+static S32 s_heapLen;
+
+void TapPath_Begin(T_TAP_WALKABLE walkable, void *ctx, S32 gridW, S32 gridH) {
+    s_walkable = walkable;
+    s_ctx = ctx;
+    s_w = (gridW > PATH_DIM) ? PATH_DIM : gridW;
+    s_h = (gridH > PATH_DIM) ? PATH_DIM : gridH;
+    memset(s_known, 0, sizeof(s_known));
+}
+
+/* Walkable, asked of the callback at most once per cell per query. */
+static S32 Walkable(S32 x, S32 z) {
+    if (x < 0 || z < 0 || x >= s_w || z >= s_h)
+        return 0;
+    U8 *k = &s_known[z * PATH_DIM + x];
+    if (*k == 0)
+        *k = s_walkable(s_ctx, x, z) ? 1 : 2;
+    return *k == 1;
+}
+
+static S32 Abs(S32 v) {
+    return v < 0 ? -v : v;
+}
+
+/* Octile distance: exact for a grid with no obstacles, never an over-estimate
+ * with them, so the first time A* reaches the goal it has the cheapest way. */
+static S32 Heuristic(S32 x, S32 z, S32 gx, S32 gz) {
+    const S32 dx = Abs(gx - x);
+    const S32 dz = Abs(gz - z);
+    const S32 lo = (dx < dz) ? dx : dz;
+    return COST_ORTH * (dx + dz) - (2 * COST_ORTH - COST_DIAG) * lo;
+}
+
+static void HeapPush(S32 f, S16 node) {
+    if (s_heapLen >= HEAP_MAX)
+        return;
+    S32 i = s_heapLen++;
+    while (i > 0) {
+        const S32 p = (i - 1) / 2;
+        if (s_heapF[p] <= f)
+            break;
+        s_heapF[i] = s_heapF[p];
+        s_heapN[i] = s_heapN[p];
+        i = p;
+    }
+    s_heapF[i] = f;
+    s_heapN[i] = node;
+}
+
+static S16 HeapPop(S32 *f) {
+    const S16 top = s_heapN[0];
+    *f = s_heapF[0];
+    s_heapLen--;
+    if (s_heapLen > 0) {
+        const S32 lf = s_heapF[s_heapLen];
+        const S16 ln = s_heapN[s_heapLen];
+        S32 i = 0;
+        for (;;) {
+            S32 c = 2 * i + 1;
+            if (c >= s_heapLen)
+                break;
+            if (c + 1 < s_heapLen && s_heapF[c + 1] < s_heapF[c])
+                c++;
+            if (s_heapF[c] >= lf)
+                break;
+            s_heapF[i] = s_heapF[c];
+            s_heapN[i] = s_heapN[c];
+            i = c;
+        }
+        s_heapF[i] = lf;
+        s_heapN[i] = ln;
+    }
+    return top;
+}
+
+S32 TapPath_Find(S32 sx, S32 sz, S32 gx, S32 gz, S16 *outX, S16 *outZ, S32 maxOut, S32 *reachedGoal) {
+    static const S8 kDx[8] = {1, -1, 0, 0, 1, 1, -1, -1};
+    static const S8 kDz[8] = {0, 0, 1, -1, 1, -1, 1, -1};
+
+    *reachedGoal = 0;
+    if (s_walkable == NULL || maxOut < 1 || sx < 0 || sz < 0 || sx >= s_w || sz >= s_h)
+        return 0;
+
+    /* A goal off the grid is the nearest cell on it. */
+    if (gx < 0)
+        gx = 0;
+    if (gz < 0)
+        gz = 0;
+    if (gx >= s_w)
+        gx = s_w - 1;
+    if (gz >= s_h)
+        gz = s_h - 1;
+
+    memset(s_state, 0, sizeof(s_state));
+    s_heapLen = 0;
+
+    /* Whoever is asking is standing on the start cell: it is walkable by
+       definition, whatever the grid says about the spot they are on (a ramp, a
+       doorway, a block they are pushing). */
+    const S32 start = sz * PATH_DIM + sx;
+    s_known[start] = 1;
+    s_g[start] = 0;
+    s_parent[start] = -1;
+    s_f[start] = Heuristic(sx, sz, gx, gz);
+    s_state[start] = 1;
+    HeapPush(s_f[start], (S16)start);
+
+    S32 best = start;
+    S32 bestH = Heuristic(sx, sz, gx, gz);
+
+    while (s_heapLen > 0) {
+        S32 f;
+        const S32 n = HeapPop(&f);
+        if (s_state[n] == 2 || f > s_f[n])
+            continue; /* a stale entry: a cheaper way to this cell was found since */
+        s_state[n] = 2;
+
+        const S32 nx = n % PATH_DIM;
+        const S32 nz = n / PATH_DIM;
+
+        const S32 h = Heuristic(nx, nz, gx, gz);
+        if (h < bestH || (h == bestH && s_g[n] < s_g[best])) {
+            best = n;
+            bestH = h;
+        }
+        if (nx == gx && nz == gz) {
+            *reachedGoal = 1;
+            break;
+        }
+
+        for (S32 d = 0; d < 8; d++) {
+            const S32 x = nx + kDx[d];
+            const S32 z = nz + kDz[d];
+            if (!Walkable(x, z))
+                continue;
+            /* No cutting corners: the hero is wider than a point, so a diagonal
+               needs both of the cells it brushes to be free. */
+            if (kDx[d] != 0 && kDz[d] != 0 && (!Walkable(nx + kDx[d], nz) || !Walkable(nx, nz + kDz[d])))
+                continue;
+
+            const S32 m = z * PATH_DIM + x;
+            if (s_state[m] == 2)
+                continue;
+            const S32 g = s_g[n] + ((kDx[d] != 0 && kDz[d] != 0) ? COST_DIAG : COST_ORTH);
+            if (s_state[m] == 0 || g < s_g[m]) {
+                s_g[m] = g;
+                s_parent[m] = (S16)n;
+                s_f[m] = g + Heuristic(x, z, gx, gz);
+                s_state[m] = 1;
+                HeapPush(s_f[m], (S16)m);
+            }
+        }
+    }
+
+    /* Walk back from the goal -- or, if it cannot be reached, from the reachable
+       cell nearest to it -- and lay the route out start first. */
+    S32 total = 0;
+    for (S32 t = best; t >= 0; t = s_parent[t])
+        total++;
+    const S32 len = (total > maxOut) ? maxOut : total;
+
+    /* A route longer than the room the caller has keeps its beginning. */
+    S32 c = best;
+    for (S32 skip = total - len; skip > 0; skip--)
+        c = s_parent[c];
+    if (total > len)
+        *reachedGoal = 0;
+
+    for (S32 i = len - 1; i >= 0; i--) {
+        outX[i] = (S16)(c % PATH_DIM);
+        outZ[i] = (S16)(c / PATH_DIM);
+        c = s_parent[c];
+    }
+    return len;
+}
+
+S32 TapPath_LineClear(S32 ax, S32 az, S32 bx, S32 bz) {
+    const S32 dx = Abs(bx - ax);
+    const S32 dz = Abs(bz - az);
+    const S32 sx = (ax < bx) ? 1 : -1;
+    const S32 sz = (az < bz) ? 1 : -1;
+    S32 err = dx - dz;
+    S32 x = ax;
+    S32 z = az;
+
+    for (;;) {
+        if (!Walkable(x, z))
+            return 0;
+        if (x == bx && z == bz)
+            return 1;
+
+        const S32 e2 = 2 * err;
+        S32 stepX = 0;
+        S32 stepZ = 0;
+        if (e2 > -dz) {
+            err -= dz;
+            stepX = sx;
+        }
+        if (e2 < dx) {
+            err += dx;
+            stepZ = sz;
+        }
+        if (stepX != 0 && stepZ != 0 && (!Walkable(x + stepX, z) || !Walkable(x, z + stepZ)))
+            return 0;
+        x += stepX;
+        z += stepZ;
+    }
+}
+
+S32 TapPath_Smooth(S16 *x, S16 *z, S32 n) {
+    if (n <= 2)
+        return n;
+
+    S32 kept = 1; /* x[0], z[0] stay where they are */
+    S32 i = 0;
+    while (i < n - 1) {
+        S32 j = n - 1;
+        while (j > i + 1 && !TapPath_LineClear(x[i], z[i], x[j], z[j]))
+            j--;
+        x[kept] = x[j];
+        z[kept] = z[j];
+        kept++;
+        i = j;
+    }
+    return kept;
+}
